{#
    Useful macros
    =============
#}
{% macro calculate_padding(column, cursor) %}
    {# move cursor to column number in the text file #}
    {{- " " * (column - cursor - 1) -}}
{% endmacro %}
{% macro format_float(value, decimals) %}
    {# define number of decimals for float values #}
    {{- "%.decimalsf" | replace('decimals', decimals) | format(value) -}}
{% endmacro %}
{% macro calculate_padding_end(column, val, cursor) %}
    {# define the padding given the column the `val' s length #}
    {{- " " * (column - (val | string | length) - cursor - 1) -}}
{% endmacro %}
{% macro tx_fields(bnd) -%}
{%- set scale = bnd[2] if (bnd is iterable and bnd|length > 2) else 'none' -%}
none {{ scale }} none
{%- endmacro %}
{#
   ==========================
   OSTRICH Configuration File
   ==========================
#}
{# Defining variable used throughout the template file #}
{% set algorithm = info.get('algorithm') %}
{# Based on algorithm, we may need algorithm-specific parameters #}
{% set algorithm_specs = info.get('algorithm_specs') %}
{# And, if `algorithm_specs` exists, we need a name equivalent for
   the Begin<name>Alg and End<name>Alg blocks #}
{% set algorithm_name = default_dicts._algorithm_equivalents.get(algorithm | lower) %}
{# Other relevant variables can be defined as following #}
{% set objective_functions = info.get('objective_functions') %}
{% set random_seed = info.get('random_seed') %}
{% set current_time = info.get('current_time') %}
{% set parameters = info.get('parameters') %}
{% set calibration_bounds = info.get('parameter_bounds') %}
{% set param_constraints = info.get('parameter_constraints') %}
{#
   ==================
   Main OSTRICH Block
   ==================

   Potentially, an OSTRICH setup can have the following sections. For
   full documentation, refer to OSTRICH's own manual.
     1. Essential OSTRICH variables,
     2. Optional OSTRICH variables,
     3. Less-common optional OSTRICH variables,
     4. Algorithm-specific parameters,
     5. Response variable(s),
     6. Objective function specifications,
     7. OSTRICH template file pairs,
     8. Extra directories to be included in individual OSTRICH runs,
     9. Parameter bounds and types, and
     10. Optional constraints.
#}
# Essential variables
ProgramType         {{ algorithm }}
ModelExecutable     ./etc/eval/eval.py
ModelSubdir         cpu_
ObjectiveFunction   GCOP

# Useful optional variables
PreserveBestModel      ./etc/scripts/archive.sh
PreserveModelOutput    no
NumDigitsOfPrecision   8
TelescopingStrategy    none
RandomSeed             {{ random_seed }}
OnObsError             1.00

# Experimental or less common optional variables
CheckSensitivities          no
SuperMUSE                   no
OstrichCaching              yes
BoxCoxTransformation        1.00
ModelOutputRedirectionFile  OstOutput.txt

{% if algorithm_specs is defined and algorithm_specs is mapping %}
# Algorithm specs
Begin{{ algorithm_name }}
  {% for key, value in algorithm_specs.items() %}
  {% if value is not none %}
  {{ key }}  {{ value }}
  {% else %}
  {{ key }}
  {% endif %}
  {% endfor %}
End{{ algorithm_name }}
{% endif %}

{% if objective_functions is defined and objective_functions is mapping %}
# Response variables
BeginResponseVars
  # name;          filename ;                                 keyword;   line   col   token
  {% for group in objective_functions.keys() if 'helper' not in group %}
    {% for flux in objective_functions.get(group).keys() %}
    {# Now iterate over the metrics and their cost function elements #}
      {% for metric in objective_functions.get(group).get(flux).keys() %}
        {% set metric_val = objective_functions.get(group).get(flux).get(metric) %}
        {% if metric_val is string %}
  {{ group }}_{{ flux }}_{{ metric }}_1     ./etc/eval/{{ group }}_{{ flux }}_{{ metric }}_1.csv ;             OST_NULL     0      1     ','
        {% else %}
          {% for of in metric_val %}
            {% set idx = loop.index %}
  {{ group }}_{{ flux }}_{{ metric }}_{{ idx }}     ./etc/eval/{{ group }}_{{ flux }}_{{ metric }}_{{ idx }}.csv ;             OST_NULL     0      1     ','
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endfor %}
  {# Constraint response variables #}
  {% set constraints = info.get('constraints') %}
  {% if constraints is defined and constraints is mapping %}
    {% for group in constraints.keys() if 'helper' not in group %}
      {% for flux in constraints.get(group).keys() %}
        {% for metric in constraints.get(group).get(flux).keys() %}
          {% set metric_info = constraints.get(group).get(flux).get(metric) %}
          {% set expressions = metric_info.get('expressions') %}
          {% if expressions is string %}
  constraint_{{ group }}_{{ flux }}_{{ metric }}_1     ./etc/eval/constraint_{{ group }}_{{ flux }}_{{ metric }}_1.csv ;             OST_NULL     0      1     ','
          {% else %}
            {% for expr in expressions %}
              {% set idx = loop.index %}
  constraint_{{ group }}_{{ flux }}_{{ metric }}_{{ idx }}     ./etc/eval/constraint_{{ group }}_{{ flux }}_{{ metric }}_{{ idx }}.csv ;             OST_NULL     0      1     ','
            {% endfor %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endfor %}
  {% endif %}
EndResponseVars

# Objective function specs
BeginGCOP
  {% for group in objective_functions.keys() if 'helper' not in group %}
    {% for flux in objective_functions.get(group).keys() %}
    {# Now iterate over the metrics and their cost function elements #}
      {% for metric in objective_functions.get(group).get(flux).keys() %}
        {% set metric_val = objective_functions.get(group).get(flux).get(metric) %}
        {% if metric_val is string %}
  CostFunction     {{ group }}_{{ flux }}_{{ metric }}_1
        {% else %}
          {% for of in metric_val %}
            {% set idx = loop.index %}
  CostFunction     {{ group }}_{{ flux }}_{{ metric }}_{{ idx }}
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endfor %}
  PenaltyFunction  APM
EndGCOP
{% endif %}

{# Constraints block #}
{% set constraints = info.get('constraints') %}
{% if constraints is defined and constraints is mapping %}
BeginConstraints
# name                                          type     CF          lower        upper        resp.var
  {% for group in constraints.keys() if 'helper' not in group %}
    {% for flux in constraints.get(group).keys() %}
      {% for metric in constraints.get(group).get(flux).keys() %}
        {% set metric_info = constraints.get(group).get(flux).get(metric) %}
        {% set expressions = metric_info.get('expressions') %}
        {% if expressions is string %}
  constraint_{{ group }}_{{ flux }}_{{ metric }}_1  general  {{ metric_info.get('cost_factor') }}  {{ metric_info.get('lower') }}  {{ metric_info.get('upper') }}  constraint_{{ group }}_{{ flux }}_{{ metric }}_1
        {% else %}
          {% for expr in expressions %}
            {% set idx = loop.index %}
  constraint_{{ group }}_{{ flux }}_{{ metric }}_{{ idx }}  general  {{ metric_info.get('cost_factor') }}  {{ metric_info.get('lower') }}  {{ metric_info.get('upper') }}  constraint_{{ group }}_{{ flux }}_{{ metric }}_{{ idx }}
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endfor %}
EndConstraints
{% endif %}

{% if objective_functions is defined and objective_functions is mapping %}
# Calculation methods for cost/objective functions
# CalculationMethod
  {% for group in objective_functions.keys()%}
    {% for flux in objective_functions.get(group).keys() %}
    {# Now iterate over the metrics and their cost function elements #}
      {% for metric in objective_functions.get(group).get(flux).keys() %}
        {% set metric_val = objective_functions.get(group).get(flux).get(metric) %}
        {% if metric_val is string %}
  # {{ group }}_{{ flux }}_{{ metric }}_1: {{ metric_val }}
        {% else %}
          {% for of in metric_val %}
            {% set idx = loop.index %}
  # {{ group }}_{{ flux }}_{{ metric }}_{{ idx }}: {{ of }}
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endfor %}
# EndCalculationMethod
{% endif %}

{# Constraint calculation method comments #}
{% set constraints = info.get('constraints') %}
{% if constraints is defined and constraints is mapping %}
# Calculation methods for constraints
# ConstraintCalculationMethod
  {% for group in constraints.keys() %}
    {% for flux in constraints.get(group).keys() %}
      {% for metric in constraints.get(group).get(flux).keys() %}
        {% set metric_info = constraints.get(group).get(flux).get(metric) %}
        {% set expressions = metric_info.get('expressions') %}
        {% if expressions is string %}
  # constraint_{{ group }}_{{ flux }}_{{ metric }}_1: {{ expressions }} [lower={{ metric_info.get('lower') }}, upper={{ metric_info.get('upper') }}, CF={{ metric_info.get('cost_factor') }}]
        {% else %}
          {% for expr in expressions %}
            {% set idx = loop.index %}
  # constraint_{{ group }}_{{ flux }}_{{ metric }}_{{ idx }}: {{ expr }} [lower={{ metric_info.get('lower') }}, upper={{ metric_info.get('upper') }}, CF={{ metric_info.get('cost_factor') }}]
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endfor %}
# EndConstraintCalculationMethod
{% endif %}

{% if parameters is iterable and parameters %}
# File pairs
BeginFilePairs
  # template file; output file
  {% for file in parameters %}
  ./etc/templates/{{ file }}.json; ./etc/eval/{{ file }}.json
  {% endfor %}
EndFilePairs
{% endif %}

# Extra directories
BeginExtraDirs
  ./model/
  ./etc/
EndExtraDirs

{% if parameters and calibration_bounds is defined and calibration_bounds is mapping %}
  {# Keeping track of whether a silt parameter has been included for each 
     soil layer and computational unit #}
  {% set silt = namespace(included = []) %}
# Parameters, bounds, and types
BeginParams
    # name   initial    min    max    type    format

  {% for param_group, param_dict in calibration_bounds.items() %}
    {# e.g., 'mesh_soil', 'vic_soil', etc. #}
    {# Checking whether `param_dict` is mapping and not empty #}
    {% if param_dict and param_dict is mapping and parameters.get(param_group) is mapping%}
    # Defining calibration parameters for `{{ param_group }}` group of parameters
      {% for unit, params in param_dict.items() %}
    # Computational unit #{{ unit }} parameters
        {% for name, bounds in params.items() %}
          {# Resolve the unit data — may be a dict (single-veg) or list (mixed-veg) #}
          {% set unit_data = parameters.get(param_group).get(unit) %}
          {% if unit_data is mapping %}
            {# Single-veg GRU: extract param name directly #}
            {% set param_name = unit_data.get(name) %}
            {# Defensive guard: a None here means the bounds key does not map
               to a real parameter for this unit. ``MESH.prepare`` validates
               this up front and raises a clear error, so reaching this branch
               with a non-string param_name should not happen. Skip silently
               rather than crashing on ``'CLAY' in None``. #}
            {% if param_name is string %}
            {# Check whether 'CLAY' or 'SAND' are included `param_name` #}
            {# If so, we need to replace them with 'SLT' because of OSTRICH's
              limitations in dealing with constraints #}
            {% if 'CLAY' in param_name %}
              {% set param_name = param_name | replace('CLAY', 'CLY') ~ '_'%}
              {% set silt_name = param_name | replace('CLY', 'SLT') %}
                {% if silt_name not in silt.included %}
                  {# Adding a silt parameter with fixed value of 0.0, min of 0.0, and max of 50.0 #}
                  {% set _ = silt.included.append(silt_name) %}
    {{ silt_name }} 0.0  0.0  50.0 none none none free
                {% endif %}
            {% elif 'SAND' in param_name %}
              {% set param_name = param_name | replace('SAND', 'SND') ~ '_' %}
              {% set silt_name = param_name | replace('SND', 'SLT') %}
              {% if silt_name not in silt.included %}
                {% set _ = silt.included.append(silt_name) %}
                {# Adding a silt parameter with fixed value of 0.0, min of 0.0, and max of 50.0 #}
    {{ silt_name }} 0.0  0.0  50.0 none none none free
              {% endif %}
            {% elif 'LAMX_EFF' in param_name %}
              {# Case-4 lamx: templated name is _<U>LAMX_EFF<suffix> (the tied
                 output). The calibration parameter proper is the _<U>LMX<suffix>_
                 proxy referenced by the TiedParams block. Rewrite accordingly. #}
              {% set param_name = param_name | replace('LAMX_EFF', 'LMX') ~ '_' %}
            {% endif %}
            {# so far, we were able to get the parameter name #}
    {{ param_name }}  {{ info.initial_values[param_group][unit][name] }}   {{ bounds[0] }}   {{ bounds[1] }} {{ tx_fields(bounds) }} free
            {% endif %}{# param_name is string #}
          {% elif unit_data is iterable %}
            {# Mixed-veg GRU: unit_data is a list of veg dicts #}
            {% if bounds is mapping %}
              {# Veg-specific param: bounds is {class_name: [min, max]} #}
              {% for veg_dict in unit_data %}
                {% set class_type = veg_dict.get('class') %}
                {% if class_type in bounds and veg_dict.get(name) is string %}
                  {% set class_bounds = bounds[class_type] %}
                  {% set param_name = veg_dict.get(name) %}
                  {% if 'CLAY' in param_name %}
                    {% set param_name = param_name | replace('CLAY', 'CLY') ~ '_'%}
                    {% set silt_name = param_name | replace('CLY', 'SLT') %}
                    {% if silt_name not in silt.included %}
                      {% set _ = silt.included.append(silt_name) %}
    {{ silt_name }} 0.0  0.0  50.0 none none none free
                    {% endif %}
                  {% elif 'SAND' in param_name %}
                    {% set param_name = param_name | replace('SAND', 'SND') ~ '_' %}
                    {% set silt_name = param_name | replace('SND', 'SLT') %}
                    {% if silt_name not in silt.included %}
                      {% set _ = silt.included.append(silt_name) %}
    {{ silt_name }} 0.0  0.0  50.0 none none none free
                    {% endif %}
                  {% elif 'LAMX_EFF' in param_name %}
                    {# Case-4 lamx in a mixed-veg GRU — see single-veg note above. #}
                    {% set param_name = param_name | replace('LAMX_EFF', 'LMX') ~ '_' %}
                  {% endif %}
    {{ param_name }}  {{ info.initial_values[param_group][unit][name][class_type] }}   {{ class_bounds[0] }}   {{ class_bounds[1] }} {{ tx_fields(class_bounds) }} free
                {% endif %}
              {% endfor %}
            {% else %}
              {# GRU-level param: bounds is [min, max], find first templated veg_dict #}
              {% set ns_gru = namespace(emitted=false) %}
              {% for veg_dict in unit_data %}
                {% if not ns_gru.emitted and veg_dict.get(name) is string %}
                  {% set ns_gru.emitted = true %}
                  {% set param_name = veg_dict.get(name) %}
                  {% if 'CLAY' in param_name %}
                    {% set param_name = param_name | replace('CLAY', 'CLY') ~ '_'%}
                    {% set silt_name = param_name | replace('CLY', 'SLT') %}
                    {% if silt_name not in silt.included %}
                      {% set _ = silt.included.append(silt_name) %}
    {{ silt_name }} 0.0  0.0  50.0 none none none free
                    {% endif %}
                  {% elif 'SAND' in param_name %}
                    {% set param_name = param_name | replace('SAND', 'SND') ~ '_' %}
                    {% set silt_name = param_name | replace('SND', 'SLT') %}
                    {% if silt_name not in silt.included %}
                      {% set _ = silt.included.append(silt_name) %}
    {{ silt_name }} 0.0  0.0  50.0 none none none free
                    {% endif %}
                  {% elif 'LAMX_EFF' in param_name %}
                    {# Case-4 lamx at the GRU level — defensive; lamn/lamx are
                       currently always veg-specific (see _CLASS_VEG_PARAMS). #}
                    {% set param_name = param_name | replace('LAMX_EFF', 'LMX') ~ '_' %}
                  {% endif %}
    {{ param_name }}  {{ info.initial_values[param_group][unit][name] }}   {{ bounds[0] }}   {{ bounds[1] }} {{ tx_fields(bounds) }} free
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endif %}
        {% endfor %}

      {% endfor %}
    {% elif param_dict and param_dict is mapping and parameters.get(param_group) is iterable %}
    # Defining calibration parameters for `{{ param_group }}` group of parameters
      {# If `param_dict` is iterable, then we assume that it is a list of
         parameter sets to be calibrated, and parameters are ordered based
         on the computational unit of each parameter set #}
      {% for unit, param_set in param_dict.items() %}
    # Computational unit #{{ unit }} parameters
        {% for name, bounds in param_set.items() %}
          {# Extract templated calibrating parameter name #}
          {% set param_name = parameters.get(param_group)[unit - 1].get(name) %}
    {{ param_name }}  {{ info.initial_values[param_group][unit][name] }}   {{ bounds[0] }}   {{ bounds[1] }} {{ tx_fields(bounds) }} free
        {% endfor %}

      {% endfor %}
    {% endif %}
  {% endfor %}
EndParams
{% endif %}

{#
  Precompute whether ``BeginTiedParams`` will have any content so that the
  block is suppressed when empty. Two producers populate it today:
    1. ``param_constraints.class`` entries whose match list is non-empty
       (the soil CLAY/SAND TiedParams loop below).
    2. ``param_constraints.class_lam`` non-empty (the LAMN/LAMX ordered-pair
       block further down).
  When adding a new producer, extend ``tied.has`` accordingly or the new
  output will be silently suppressed.
#}
{% set tied = namespace(has=false) %}
{% if param_constraints is defined and param_constraints is mapping %}
  {% set _cl = param_constraints.get('class_lam') %}
  {% if _cl is mapping and _cl %}{% set tied.has = true %}{% endif %}
  {% set _cm = param_constraints.get('class') %}
  {% if _cm is mapping %}
    {% for _u, _m in _cm.items() %}
      {% if _m %}{% set tied.has = true %}{% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
{% if tied.has %}
# Calibration constraints
BeginTiedParams
{#
  FIXME: Implement a systematic constraints definition mechanism
    For now, only focusing on soil parameters for MESH layers; a systematic
    constraints definition mechanism is needed to define any constraint for
    any calibration process.

  The variables that can be included in the constraint definition are:
    - `clay1`, `clay2`, `clay3`: fraction of clay in layer 1, 2, and 3
    - `sand1`, `sand2`, `sand3`: fraction of sand in layer 1, 2, and 3

  Note:
    - Silt values cannot be explicitely defined, as they are calculated as
      `silt = 1 - clay - sand`.
    - The sum of clay, sand, and silt in each layer must be equal to 100.
    - The constraints are defined for each layer separately, and cannot
      include parameters from different layers.
#}
  {% for constraint_group, constraint_dict in param_constraints.items() %}
    {# Defining constraint parameters explicitely for MESH soil layers #}
    {% set constraint_params = ['clay1', 'clay2', 'clay3', 'sand1', 'sand2', 'sand3'] %}
    {# Before iterating over the soil layers, it is important to keep
       track of layer numbers #}
    {% set iterated_layers = [] %}
    {# Defining constraints for each computational unit #}
    {% if constraint_dict is mapping %}
      {% for unit, param_list in constraint_dict.items() %}
        {% set iterated_layers = [] %}
        {% if param_list is iterable and param_list %}
          {% for param in param_list %}
            {% if param in constraint_params %}
              {# Extract soil layer number for which the parameter is defined #}
              {% set layer_num = param[4:] | int %}
              {# Also adding the layer number to the list of iterated layers #}
              {% if layer_num not in iterated_layers %}
                {% set _ = iterated_layers.append(layer_num) %}
    # Computational unit #{{ unit }} constraints
    # Soil layer #{{ layer_num }}
                {# Now, having a list of parameters for which we will defined constraints #}
                {# Resolve unit_data — may be a dict (single-veg) or list (mixed-veg) #}
                {% set unit_data_c = parameters.get(constraint_group).get(unit) %}
                {% if unit_data_c is mapping %}
                  {% set clay_val = unit_data_c.get('clay' ~ layer_num) %}
                  {% set sand_val = unit_data_c.get('sand' ~ layer_num) %}
                {% elif unit_data_c is iterable %}
                  {# Mixed-veg GRU: soil params are GRU-level, templated in the last veg_dict #}
                  {% set ns_clay = namespace(val=none) %}
                  {% set ns_sand = namespace(val=none) %}
                  {% for veg_dict in unit_data_c | reverse %}
                    {% if ns_clay.val is none and veg_dict.get('clay' ~ layer_num) is defined %}
                      {% set ns_clay.val = veg_dict.get('clay' ~ layer_num) %}
                    {% endif %}
                    {% if ns_sand.val is none and veg_dict.get('sand' ~ layer_num) is defined %}
                      {% set ns_sand.val = veg_dict.get('sand' ~ layer_num) %}
                    {% endif %}
                  {% endfor %}
                  {% set clay_val = ns_clay.val %}
                  {% set sand_val = ns_sand.val %}
                {% endif %}
                {% set layer_params = {
                  'clay' ~ layer_num: clay_val,
                  'sand' ~ layer_num: sand_val,
                  'silt' ~ layer_num: '_' ~ unit ~ 'SILT' ~ layer_num,
                  }
                %}
                {# Also, make proxy parameters because of OSTRICH's limitations
                  in dealing with constraints #}
                {% set proxy_params = {
                  'clay' ~ layer_num: '_' ~ unit ~ 'CLY' ~ layer_num ~ '_',
                  'sand' ~ layer_num: '_' ~ unit ~ 'SND' ~ layer_num ~ '_',
                  'silt' ~ layer_num: '_' ~ unit ~ 'SLT' ~ layer_num ~ '_',
                }
                %}
                {# Count which values are actually strings #}
                {% set string_keys = layer_params.items()
                          | selectattr(1, 'string')
                          | map(attribute=0)
                          | list
                %}
                {# Define necessary local OSTRICH parameters #}
                {% set sum_soil = '_' ~ unit ~ 'SUM_SOIL' ~ layer_num ~ '_' %}
                {# If, all soil parameters need to be defined in constraints #}
                {% if string_keys | length == 3 %}
    # name          np   pname1      pname2      pname3      type    dtype1   dtype2   dtype3   format
    {{ sum_soil }}    3    {{ proxy_params.get(string_keys[0]) }}     {{ proxy_params.get(string_keys[1]) }}     {{ proxy_params.get(string_keys[2]) }}     wsum    1        1        1        free
    # name     np   pname1      pname2           type1    c3   c2   c1   c0    format
    {{ layer_params.get(string_keys[0]) }}    2    {{ proxy_params.get(string_keys[0]) }}     {{ sum_soil }}     ratio    100  1    1    0     free
    {{ layer_params.get(string_keys[1]) }}    2    {{ proxy_params.get(string_keys[1]) }}     {{ sum_soil }}     ratio    100  1    1    0     free
                {# Now, defining the ratio constraints #}
                {% endif %}
                {# If only two parameters are defined, we need to create the third one #}
                {% if string_keys | length == 2 %}
                  {# Now that we know the parameter that is left out, we need to identify it #}
    # name          np   pname1      pname2      type1   dtype1   dtype2   format
    {{ sum_soil }}    2    {{ proxy_params.get(string_keys[0]) }}     {{ proxy_params.get(string_keys[1]) }}     wsum    1        1        free
                  {# c0 would be the left out parameter value that is not entered
                    in the calibration process #}
                  {% set ns = namespace(left_out_param='') %}
                  {% for item in (layer_params.keys() | list) %}
                    {% if item not in string_keys %}
                      {% set ns.left_out_param = item %}
                    {% endif %}
                  {% endfor %}
                  {% set c0 = layer_params.get(ns.left_out_param) %}
    # name     np   pname1      pname2           type1    c3   c2   c1   c0         format
    {{ layer_params.get(string_keys[0]) }}    2    {{ proxy_params.get(string_keys[0]) }}     {{ sum_soil }}     ratio    100  1    1    {{ "%.3f" | format(c0) }}     free
                {% endif %}
              {% endif %}
            {% endif %}

          {% endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{#
   LAMN/LAMX ordered-pair TiedParams (case 4 only)
   ===============================================
   For every (unit, class?) pair listed under ``constraints.class_lam``
   emit the four-line block that yields an effective upper
   ``_<U>LAMX_EFF<suffix> = max(LAMN, LAMX)`` from the calibration
   proxies ``_<U>LMN<suffix>_`` and ``_<U>LMX<suffix>_``. The
   positive-part construction below matches the mathematical identity
   ``max(a, b) = b + max(0, a - b) = b + (|a - b| + (a - b)) / 2``.
#}
{% set class_lam = param_constraints.get('class_lam') if param_constraints is mapping else none %}
{% if class_lam is mapping %}
  {% for unit, class_map in class_lam.items() %}
    {% if class_map is mapping %}
      {% for cls, _flag in class_map.items() %}
        {% set suffix = ('_' ~ (cls | upper)) if cls is string else '' %}
        {% set lmn = '_' ~ unit ~ 'LMN' ~ suffix ~ '_' %}
        {% set lmx = '_' ~ unit ~ 'LMX' ~ suffix ~ '_' %}
        {% set absd = '_' ~ unit ~ 'LAMN_LAMX_ABSD' ~ suffix %}
        {% set diff = '_' ~ unit ~ 'LAMN_LAMX_DIFF' ~ suffix %}
        {% set shift = '_' ~ unit ~ 'LAMN_LAMX_SHIFT' ~ suffix %}
        {% set eff = '_' ~ unit ~ 'LAMX_EFF' ~ suffix %}
    # Computational unit #{{ unit }}{% if cls is string %} ({{ cls }}){% endif %} LAMN/LAMX ordered-pair constraint
    # |LAMN - LAMX| via dist (y1 = y2 collapses the y-term)
    {{ absd }}   4   {{ lmn }}   {{ lmn }}   {{ lmx }}   {{ lmn }}   dist   free
    # signed difference LAMN - LAMX
    {{ diff }}   2   {{ lmn }}   {{ lmx }}   wsum   1.0   -1.0   free
    # positive-part shift: max(0, LAMN - LAMX) = (DIFF + ABSD) / 2
    {{ shift }}  2   {{ diff }}   {{ absd }}   wsum   0.5   0.5   free
    # effective upper: LAMX + shift = max(LAMN, LAMX)
    {{ eff }}    2   {{ lmx }}   {{ shift }}   wsum   1.0   1.0   free
      {% endfor %}
    {%- endif -%}
  {%- endfor -%}
{%- endif %}
EndTiedParams
{%- endif -%}
